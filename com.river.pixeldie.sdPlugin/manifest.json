{
	"Name": "Pixel Dice",
	"Version": "0.1.0.0",
	"Author": "River Marks",
	"Actions": [
		{
			"Name": "Connection Manager",
			"UUID": "com.river.pixeldie.connectionmanager",
			"Icon": "imgs/connection_manager_icon",
			"Tooltip": "Allows management of connected Pixel devices",
			"PropertyInspectorPath": "ui/find-devices.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/standard",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Roll",
			"UUID": "com.river.pixeldie.roll",
			"Icon": "imgs/d20_icon",
			"Tooltip": "Displays the rolling status of selected die",
			"PropertyInspectorPath": "ui/device-dropdown.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/d20",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Difficulty Check",
			"UUID": "com.river.pixeldie.dc",
			"Icon": "imgs/difficulty_check_icon",
			"Tooltip": "Allows configuration of Difficulty Check on a given die",
			"PropertyInspectorPath": "ui/dc-configuration.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/d20_flat",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/d20_adv",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/d20_dis",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Difficulty Check Changer",
			"UUID": "com.river.pixeldie.dcchange",
			"Icon": "imgs/plus_minus_icon",
			"Tooltip": "Allows increasing or decreasing of adjacent difficulty check",
			"PropertyInspectorPath": "ui/dc-change-configuration.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/plus_minus_icon",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/minus",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/plus",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Difficulty Check Toggle",
			"UUID": "com.river.pixeldie.dctoggle",
			"Icon": "imgs/toggle_icon",
			"Tooltip": "Enables or disables the adjacent difficulty check",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/toggle_disabled",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/toggle_enabled",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Battery",
			"UUID": "com.river.pixeldie.battery",
			"Icon": "imgs/battery_icon",
			"Tooltip": "Displays the battery level of selected die",
			"PropertyInspectorPath": "ui/device-dropdown.html",
			"UserTitleEnabled": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/battery_100",
					"TitleAlignment": "middle"
				}
			]
		}
	],
	"Category": "Pixel Dice",
	"CategoryIcon": "imgs/pixel_icon",
	"CodePath": "bin/plugin.js",
	"Description": "Unofficial Stream Deck Pixel Dice integration for viewing information, setting DCs, and interacting with bluetooth dice",
	"Icon": "imgs/pixel_icon",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "com.river.pixeldie"
}